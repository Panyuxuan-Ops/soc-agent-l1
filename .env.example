# ---------- 基础 ----------
SOC_PROJECT_ROOT=
SOC_DATA_DIR=./data
# 可选：分离 trace 路径；默认是 $SOC_DATA_DIR/traces.sqlite3 和 traces.jsonl
# SOC_TRACE_DB=./data/traces.sqlite3
# SOC_TRACE_JSONL=./data/traces.jsonl
SOC_LOG_LEVEL=INFO
SOC_QUEUE_MODE=redis          # redis | memory
SOC_TRACE_RETENTION_DAYS=7

# ---------- Redis Stream ----------
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_STREAM=wazuh:alerts
REDIS_GROUP=soc-l1
REDIS_DLQ=wazuh:alerts:dlq
REDIS_CONSUMER=soc-l1-worker-1
REDIS_MAX_RETRIES=3
REDIS_CLAIM_IDLE_MS=60000
CONSUMER_WORKERS=2

# ---------- Wazuh ----------
WAZUH_MODE=mock               # mock | indexer
# Docker 内访问宿主机时，不能写 127.0.0.1；改成内网 IP 或 host.docker.internal
WAZUH_INDEXER_URL=https://127.0.0.1:9200
WAZUH_INDEXER_INDEX=wazuh-alerts-*
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=changeme
WAZUH_INDEXER_VERIFY_TLS=false
WAZUH_WINDOW_MINUTES=15

# ---------- Dify ----------
DIFY_MODE=mock                # mock | api
# Docker 内访问宿主机 Dify 时，改成内网 IP 或 host.docker.internal
DIFY_API_BASE=http://127.0.0.1:5001/v1
DIFY_API_KEY=
DIFY_WORKFLOW_TIMEOUT_S=90
# mock Dify 只用于本地闭环演示，生产必须设为 api
DIFY_MOCK_API_KEY=dev-mock-key

# ---------- Agent / LLM ----------
AGENT_MODE=deterministic      # deterministic | deepseek（仅 mock Dify 使用）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 直接调用 API 的模型；Dify 插件模型列表可能不同，DSL 默认用 deepseek-flash
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_S=45

# ---------- 知识库 ----------
KNOWLEDGE_MODE=local          # local | dify
DIFY_DATASET_ID=
DIFY_DATASET_API_KEY=
DIFY_RETRIEVAL_METHOD=hybrid_search

# ---------- 工具服务鉴权 ----------
TOOL_API_TOKEN=
APPROVAL_API_TOKEN=

# ---------- 审批（人在回路） ----------
APPROVAL_BASE_URL=http://127.0.0.1:8002
APPROVAL_PUBLIC_URL=http://127.0.0.1:8002
APPROVAL_TTL_HOURS=24
APPROVAL_EXPOSE_LINKS=true    # 生产建议 false，只通过邮件/钉钉下发链接

# 钉钉机器人（可选）
DINGTALK_WEBHOOK=
DINGTALK_SECRET=

# SMTP 邮件（可选）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# ---------- Wazuh bridge ----------
BRIDGE_TOKEN=
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8000
