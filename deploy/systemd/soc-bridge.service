[Unit]
Description=SOC L1 Wazuh -> Redis bridge
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=socagent
Group=socagent
WorkingDirectory=/opt/soc-agent-l1
EnvironmentFile=/etc/soc-agent-l1.env
Environment=PYTHONPATH=/opt/soc-agent-l1/src
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/soc-agent-l1/.venv/bin/python -m soc_agent serve bridge --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/soc-agent-l1/data /opt/soc-agent-l1/runtime
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
