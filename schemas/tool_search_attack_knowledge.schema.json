{
  "type": "function",
  "function": {
    "name": "search_attack_knowledge",
    "description": "在 MITRE ATT&CK 技术摘要与 IOC 列表中检索与告警关键词匹配的技术。用于解释攻击行为、补充检测依据；不要用它查询主机状态。",
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "告警关键词、规则描述或技术 ID，例如 ssh brute force 或 T1110"
        },
        "top_k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 3,
          "description": "返回条数，默认 3"
        }
      },
      "required": [
        "query"
      ]
    }
  }
}
