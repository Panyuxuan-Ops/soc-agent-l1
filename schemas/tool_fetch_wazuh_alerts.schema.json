{
  "type": "function",
  "function": {
    "name": "fetch_wazuh_alerts",
    "description": "只读查询最近 15 分钟的 Wazuh 告警，用于判断同一源 IP 是否在短时间内重复触发。不传 src_ip 时返回最近的高等级告警，用于了解主机整体风险。",
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 5,
          "description": "返回条数，默认 5，最大 20"
        },
        "min_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16,
          "description": "最低 Wazuh rule.level；不传则不过滤"
        },
        "src_ip": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "description": "源 IP（IPv4 或 IPv6）"
        }
      },
      "required": []
    }
  }
}
